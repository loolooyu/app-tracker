{
  "name": "appfolio",
  "version": "1.0.0",
  "private": true,
  "description": "Local-first job application tracker with a Chrome capture extension",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/shared",
    "apps/api",
    "apps/web",
    "apps/extension"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build -w @appfolio/web && npm run build -w @appfolio/api && npm run build -w @appfolio/extension",
    "start": "node apps/api/dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:all": "npm run typecheck && npm test && npm run build && npm run test:e2e",
    "demo": "node apps/api/dist/main.js --data-dir ./.demo-data",
    "verify:live": "node scripts/verify-live.mjs",
    "peek": "tsx scripts/peek-extract.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/chrome": "0.3.4",
    "@types/jsdom": "30.0.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/yauzl": "3.4.0",
    "@types/yazl": "3.3.1",
    "@vitejs/plugin-react": "6.1.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
