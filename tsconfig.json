{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": false,
    "types": ["node", "chrome"],
    "noEmit": true
  },
  "include": ["packages/*/test", "packages/*/src", "apps/*/src", "apps/*/test", "apps/*/scripts", "tests", "vitest.config.ts", "playwright.config.ts"]
}
